#!/bin/bash

set -euo pipefail
shopt -s nullglob

ORIG_ARGV=("$@")
REMOTE_LABEL=""

readonly CONF_FILE=/etc/btrctl.conf

HOST_LABEL=$(hostname)
BTRFS_MOUNT_POINT=/btrfs
SUBVOLUMES=(@)
TRUNK_MOUNT_POINT=/trunk

SSH="${SUDO_USER:+sudo -u "$SUDO_USER"} /usr/bin/ssh"

if [ -f "$CONF_FILE" ]; then
  source "$CONF_FILE"
fi

OUT_RESET=''
OUT_BOLD=''
OUT_RED=''
OUT_GREEN=''
OUT_YELLOW=''
OUT_MAGENTA=''
OUT_CYAN=''
ERR_RESET=''
ERR_RED=''
ERR_YELLOW=''
ERR_BLUE=''
ERR_WHITE=''

if [ -z "${NO_COLOR:-}" ]; then
  if [ -t 1 ]; then
    OUT_RESET=$'\033[0m'
    OUT_BOLD=$'\033[1m'
    OUT_RED=$'\033[1;31m'
    OUT_GREEN=$'\033[1;32m'
    OUT_YELLOW=$'\033[1;33m'
    OUT_MAGENTA=$'\033[1;35m'
    OUT_CYAN=$'\033[1;36m'
  fi

  if [ -t 2 ]; then
    ERR_RESET=$'\033[0m'
    ERR_RED=$'\033[1;31m'
    ERR_YELLOW=$'\033[1;33m'
    ERR_BLUE=$'\033[1;34m'
    ERR_WHITE=$'\033[1;37m'
  fi
fi

_log() {
  local color="$1" level="$2"; shift 2
  local label=""
  [ -n "$REMOTE_LABEL" ] && label="${ERR_WHITE}[${REMOTE_LABEL}]${ERR_RESET} "
  echo "${color}[${level}]${ERR_RESET} ${label}$*" >&2
}

_die() {
  _log "$ERR_RED" ERROR "$@"
  exit 1
}

_error() {
  _log "$ERR_RED" ERROR "$@"
}

_warn() {
  _log "$ERR_YELLOW" WARN "$@"
}

_info() {
  _log "$ERR_BLUE" INFO "$@"
}

CONF_OVERLAY_FILE="${BTRCTL_CONF:-}"
if [ -n "$CONF_OVERLAY_FILE" ]; then
  [ -f "$CONF_OVERLAY_FILE" ] || _die "config overlay file not found: ${CONF_OVERLAY_FILE}"
  source "$CONF_OVERLAY_FILE"
fi

_require_root() {
  [ "$(id -u)" -eq 0 ] && return
  command -v sudo > /dev/null 2>&1 || _die "this command must be run as root"
  if [ -n "$CONF_OVERLAY_FILE" ]; then
    exec sudo BTRCTL_CONF="$CONF_OVERLAY_FILE" -- "$0" "${ORIG_ARGV[@]}"
  else
    exec sudo -- "$0" "${ORIG_ARGV[@]}"
  fi
}

_confirm() {
  local prompt="$1" answer
  read -r -p "${prompt} [y/N] " answer || answer=""
  case "$answer" in
    y|Y) return 0 ;;
    *) return 1 ;;
  esac
}

_update_symlink() {
  local target="$1" link_path="$2"
  if [ -e "$link_path" ] && [ ! -L "$link_path" ]; then
    _warn "${link_path} exists and is not a symlink"
    return 1
  fi
  ln -sfn "$target" "$link_path"
}

_ensure_btrfs_mounted() {
  _require_root
  mountpoint -q "$BTRFS_MOUNT_POINT" || _die "${BTRFS_MOUNT_POINT} is not mounted"
}

_run_snapshot_hook() {
  local hook="$1"
  local snapshot_dir="${2:-}"
  local script="${BTRFS_MOUNT_POINT}/.btrctl/${hook}"
  [ -e "$script" ] || return 0

  if [ ! -x "$script" ]; then
    _warn "${script} exists but is not executable"
    return 0
  fi

  _info "Running ${hook} hook ..."
  if [ -n "$snapshot_dir" ]; then
    (cd "$BTRFS_MOUNT_POINT" && BTRFS_MOUNT_POINT="$BTRFS_MOUNT_POINT" SNAPSHOT_DIR="$snapshot_dir" "$script")
  else
    (cd "$BTRFS_MOUNT_POINT" && BTRFS_MOUNT_POINT="$BTRFS_MOUNT_POINT" "$script")
  fi
}

_ensure_trunk_mounted() {
  _require_root
  mountpoint -q "$TRUNK_MOUNT_POINT" || _die "${TRUNK_MOUNT_POINT} is not mounted"
}

_snapshot_subvol_path() {
  local set_dir="$1" timestamp="$2" label="$3" subvol="$4"
  echo "${set_dir}/@snapshot-${timestamp}-${label}-${subvol}"
}

_is_set_name() {
  case "$1" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]) return 0 ;;
    *) return 1 ;;
  esac
}

_validate_tags() {
  local tag
  for tag in "$@"; do
    [ -n "$tag" ] || _die "tags must not be empty"
    [[ "$tag" != -* ]] || _die "tags must not begin with '-': ${tag}"
    [[ "$tag" != *,* ]] || _die "tags must not contain commas: ${tag}"
    [[ "$tag" != *$'\n'* ]] || _die "tags must not contain newlines"
  done
}

_tag_present() {
  local wanted="$1" tag; shift
  for tag in "$@"; do
    [ "$tag" != "$wanted" ] || return 0
  done
  return 1
}

_read_tags() {
  local dir="$1" varname="$2" tag
  local -n _tags_out="$varname"
  _tags_out=()
  [ -f "${dir}/.btrctl/tags" ] || return 0
  while IFS= read -r tag || [ -n "$tag" ]; do
    [ -n "$tag" ] || continue
    _tag_present "$tag" "${_tags_out[@]}" || _tags_out+=("$tag")
  done < "${dir}/.btrctl/tags"
}

_write_tags() {
  local dir="$1" tag; shift
  local -a unique_tags=()
  _validate_tags "$@"
  for tag in "$@"; do
    _tag_present "$tag" "${unique_tags[@]}" || unique_tags+=("$tag")
  done
  if [ "${#unique_tags[@]}" -gt 0 ]; then
    mkdir -p "${dir}/.btrctl"
    printf '%s\n' "${unique_tags[@]}" > "${dir}/.btrctl/tags"
  else
    rm -f "${dir}/.btrctl/tags"
  fi
}

_display_tags() {
  local -a display_tags=()
  local tag separator=""
  _read_tags "$1" display_tags
  for tag in "${display_tags[@]}"; do
    printf '%s%s' "$separator" "$tag"
    separator=", "
  done
}

_modify_tags() {
  local dir="$1" action="$2" tag; shift 2
  local -a current_tags=() updated_tags=()
  _read_tags "$dir" current_tags
  case "$action" in
    add) _write_tags "$dir" "${current_tags[@]}" "$@" ;;
    rm)
      for tag in "${current_tags[@]}"; do
        _tag_present "$tag" "$@" || updated_tags+=("$tag")
      done
      _write_tags "$dir" "${updated_tags[@]}"
      ;;
  esac
}

_validate_tag_operation() {
  local cmd_name="$1" action="$2"; shift 2
  case "$action" in
    add|rm) ;;
    *) _die "${cmd_name}: expected add or rm" ;;
  esac
  [ $# -gt 0 ] || _die "${cmd_name}: at least one TAG is required"
  _validate_tags "$@"
}

_next_most_recent_set() {
  local dir="$1" d name
  local names=()
  for d in "$dir"/*/; do
    name=$(basename "$d")
    _is_set_name "$name" && names+=("$name")
  done
  if [ "${#names[@]}" -gt 0 ]; then
    printf '%s\n' "${names[@]}" | sort | tail -n1
  fi
}

_snapshot_flags() {
  local snapshots_dir="$1" set_name="$2"
  local flags="" link link_name link_target

  if [ -L "${snapshots_dir}/latest" ]; then
    link_target=$(readlink -f "${snapshots_dir}/latest" 2>/dev/null || true)
    if [ -n "$link_target" ] && [ -d "$link_target" ] && \
      [ "$(basename "$link_target")" = "$set_name" ]; then
      flags="latest"
    fi
  fi

  for link in "${snapshots_dir}"/trunk_*; do
    [ -L "$link" ] || continue
    link_name=$(basename "$link")
    link_target=$(readlink -f "$link" 2>/dev/null || true)
    [ -n "$link_target" ] && [ -d "$link_target" ] || continue
    [ "$(basename "$link_target")" = "$set_name" ] || continue
    [ -n "$flags" ] && flags+=", "
    flags+="$link_name"
  done

  printf '%s\n' "$flags"
}

_delete_set_dir() {
  local set_dir="$1"
  _info "This will permanently delete: ${set_dir}"
  _confirm "Proceed?" || { _info "Aborted."; return 1; }
  _info "Deleting snapshots ..."
  _delete_set_contents "$set_dir"
}

_delete_set_contents() {
  local set_dir="$1" subvol_path
  for subvol_path in "$set_dir"/@snapshot-*; do
    btrfs subvolume delete "$subvol_path" || return 1
  done
  rm -rf "$set_dir"
}

_prune_protection() {
  local set_dir="$1" local_sets="$2" snapshots_dir="${1%/*}"
  local -a protection_tags=()
  local reasons="" target link resolved
  _read_tags "$set_dir" protection_tags || return 1
  _tag_present noprune "${protection_tags[@]}" && reasons="noprune"
  if [ "$local_sets" -eq 1 ]; then
    target=$(readlink -f "$set_dir") || return 1
    for link in "${snapshots_dir}/latest" "${snapshots_dir}"/trunk_*; do
      [ -L "$link" ] || continue
      resolved=$(readlink -f "$link" 2>/dev/null || true)
      [ "$resolved" = "$target" ] || continue
      reasons+="${reasons:+, }${link##*/}"
    done
  fi
  printf '%s' "$reasons"
}

_prune_month_cutoff() {
  local now="$1" year month day time last_day
  read -r year month day time < <(date -d "@${now}" '+%Y %m %d %H:%M:%S')
  # Clamp February 29 when the previous year is not a leap year.
  last_day=$(date -d "$((10#$year - 1))-${month}-01 +1 month -1 day" +%d) || return 1
  [ "$((10#$day))" -le "$((10#$last_day))" ] || day="$last_day"
  # Relative arithmetic normalizes a cutoff falling in a spring-forward gap.
  date -d "${year}-${month}-${day} ${time} last year" +%s
}

_prune_plan() {
  local dir="$1" local_sets="$2" now="$3" month_cutoff="$4"
  local -n _plan_names="$5" _plan_reasons="$6"
  _plan_names=()
  _plan_reasons=()
  local -a epochs=() keys=()
  local -A winners=()
  local d name parsed epoch normalized weekday reason week key index previous
  # Fixed retention windows, in elapsed seconds. Calendar months are separate.
  local all_cutoff=$((now - 86400)) hour_cutoff=$((now - 259200))
  local day_cutoff=$((now - 604800)) week_cutoff=$((now - 2419200))

  for d in "$dir"/*/; do
    d="${d%/}"
    [ ! -L "$d" ] || continue
    name="${d##*/}"
    _is_set_name "$name" || continue
    parsed=$(date -d "${name:0:10} ${name:11:2}:${name:13:2}:${name:15:2}" \
      '+%s %Y-%m-%d-%H%M%S %w' 2>/dev/null) || {
      _warn "Skipping invalid snapshot timestamp: ${d}"
      continue
    }
    read -r epoch normalized weekday <<< "$parsed"
    if [ "$normalized" != "$name" ]; then
      _warn "Skipping invalid snapshot timestamp: ${d}"
      continue
    fi
    reason=$(_prune_protection "$d" "$local_sets") || return 1
    index=${#_plan_names[@]}
    _plan_names+=("$name")
    epochs+=("$epoch")
    if [ "$epoch" -gt "$now" ]; then
      _plan_reasons+=("${reason}${reason:+, }future")
      continue
    fi
    [ "$epoch" -lt "$all_cutoff" ] || reason+="${reason:+, }recent"
    _plan_reasons+=("$reason")
    keys=("yearly:${name:0:4}")
    [ "$epoch" -lt "$hour_cutoff" ] || keys+=("hourly:${name:0:13}")
    [ "$epoch" -lt "$day_cutoff" ] || keys+=("daily:${name:0:10}")
    if [ "$epoch" -ge "$week_cutoff" ]; then
      week=$(date -d "${name:0:10} 12:00:00 ${weekday} days ago" +%F) || return 1
      keys+=("weekly:${week}")
    fi
    [ "$epoch" -lt "$month_cutoff" ] || keys+=("monthly:${name:0:7}")
    for key in "${keys[@]}"; do
      previous="${winners[$key]:-}"
      if [ -z "$previous" ] || [ "$epoch" -ge "${epochs[previous]}" ]; then
        winners["$key"]="$index"
      fi
    done
  done

  # Iterate tiers explicitly so dry-run reasons have a stable order.
  local tier
  for tier in hourly daily weekly monthly yearly; do
    for key in "${!winners[@]}"; do
      [[ "$key" = "${tier}:"* ]] || continue
      index="${winners[$key]}"
      _plan_reasons[index]+="${_plan_reasons[index]:+, }${tier}"
    done
  done
}

# Print a printf-formatted table row without trailing padding, optionally
# wrapped in STYLE (e.g. bold for headers).
_table_row() {
  local style="$1" line; shift
  # shellcheck disable=SC2059 # the format string is supplied by the caller
  printf -v line "$@"
  line="${line%"${line##*[! ]}"}"
  printf '%s%s%s\n' "$style" "$line" "${style:+$OUT_RESET}"
}

_run_prune() {
  local dry_run="$1" local_sets="$2"; shift 2
  local now month_cutoff dir label index reason protection
  now=$(date +%s) || return 1
  month_cutoff=$(_prune_month_cutoff "$now") || return 1
  local -a names=() reasons=() delete_paths=()
  local retained=0 deleted=0 skipped=0 total=0
  local -a row_actions=() row_hosts=() row_sets=() row_reasons=()
  local host_width=4 set_width=3
  # Collect rows first so column widths can be sized to the content.
  _prune_row() {
    row_actions+=("$1")
    row_hosts+=("$2")
    row_sets+=("$3")
    row_reasons+=("$4")
    [ "${#2}" -le "$host_width" ] || host_width=${#2}
    [ "${#3}" -le "$set_width" ] || set_width=${#3}
  }
  for dir in "$@"; do
    label="$HOST_LABEL"
    [ "$local_sets" -eq 1 ] || { label="${dir##*/}"; label="trunk/${label#@}"; }
    _prune_plan "$dir" "$local_sets" "$now" "$month_cutoff" names reasons || return 1
    for index in "${!names[@]}"; do
      total=$((total + 1))
      reason="${reasons[index]}"
      if [ -n "$reason" ]; then
        retained=$((retained + 1))
        [ "$dry_run" -eq 0 ] || _prune_row KEEP "$label" "${names[index]}" "$reason"
      else
        delete_paths+=("${dir}/${names[index]}")
        _prune_row DELETE "$label" "${names[index]}" 'outside retention policy'
      fi
    done
  done
  if [ "${#row_actions[@]}" -gt 0 ]; then
    local i color previous_host="" rest token token_color reason_display
    _table_row "$OUT_BOLD" '%-*s    %-*s    %-6s    %s' \
      "$host_width" HOST "$set_width" SET ACTION REASON
    for i in "${!row_actions[@]}"; do
      # Highlight protections and anomalies; time-based tiers stay plain.
      reason_display=""
      rest="${row_reasons[i]}"
      while [ -n "$rest" ]; do
        token="${rest%%, *}"
        if [ "$token" = "$rest" ]; then rest=""; else rest="${rest#*, }"; fi
        case "$token" in
          latest|trunk_*) token_color="$OUT_CYAN" ;;
          noprune) token_color="$OUT_MAGENTA" ;;
          future) token_color="$OUT_YELLOW" ;;
          *) token_color="" ;;
        esac
        [ -z "$token_color" ] || token="${token_color}${token}${OUT_RESET}"
        reason_display+="${reason_display:+, }${token}"
      done
      if [ -n "$previous_host" ] && [ "${row_hosts[i]}" != "$previous_host" ]; then
        printf '\n'
      fi
      previous_host="${row_hosts[i]}"
      case "${row_actions[i]}" in
        KEEP) color="$OUT_GREEN" ;;
        DELETE) color="$OUT_RED" ;;
        *) color="" ;;
      esac
      _table_row '' '%-*s    %-*s    %s%-6s%s    %s' \
        "$host_width" "${row_hosts[i]}" "$set_width" "${row_sets[i]}" \
        "$color" "${row_actions[i]}" "$OUT_RESET" "$reason_display"
    done
  fi
  _info "Snapshot sets: ${total}; keep: ${retained}; prune: ${#delete_paths[@]}"
  [ "$dry_run" -eq 0 ] || { _info "Dry run; no snapshots deleted."; return 0; }
  [ "${#delete_paths[@]}" -gt 0 ] || { _info "Nothing to prune."; return 0; }
  _confirm "Permanently delete ${#delete_paths[@]} snapshot set(s)?" || { _info "Aborted."; return 1; }
  for dir in "${delete_paths[@]}"; do
    if [ ! -d "$dir" ] || [ -L "$dir" ]; then
      _warn "Skipping changed or missing snapshot set: ${dir}"
      skipped=$((skipped + 1))
      continue
    fi
    protection=$(_prune_protection "$dir" "$local_sets") || return 1
    if [ -n "$protection" ]; then
      _info "Keeping newly protected snapshot set: ${dir} (${protection})"
      skipped=$((skipped + 1))
      continue
    fi
    _info "Pruning snapshot set: ${dir}"
    if ! _delete_set_contents "$dir"; then
      _error "Failed to prune ${dir}; stopped after ${deleted} deletion(s), ${skipped} skipped; partial set may require clean up"
      return 1
    fi
    deleted=$((deleted + 1))
  done
  _info "Pruned ${deleted} snapshot set(s); skipped ${skipped}."
}

_remote_sudo_prompt() {
  local host="$1" m='' r=''
  if [ -z "${NO_COLOR:-}" ]; then
    m=$'\033[1;95m'
    r=$'\033[0m'
  fi
  printf '%s[remote sudo]%s password for %s: ' "$m" "$r" "$host"
}

_ssh() {
  local host="$1"; shift
  $SSH "$host" "$@"
}

_ssh_tty() {
  local host="$1"; shift
  $SSH -t "$host" "$@"
}

_dispatch_remote() {
  local host="$1" subcmd="$2"; shift 2
  local cmd arg
  cmd="sudo -p $(printf '%q' "$(_remote_sudo_prompt "$host")") btrctl --remote-label $(printf '%q' "$host") ${subcmd}"
  for arg in "$@"; do
    cmd+=" $(printf '%q' "$arg")"
  done
  _ssh_tty "$host" "$cmd"
}

_remote_root() {
  local host="$1" pw="$2"
  shift 2
  printf '%s\n' "$pw" | _ssh "$host" "sudo -S -p '' sh -c $(printf '%q' "$*")"
}

_remote_config() {
  local host="$1" raw line
  raw=$(_ssh "$host" "btrctl config") || _die "failed to fetch remote config from ${host}"

  local subvolumes_line=""
  REMOTE_HOST_LABEL=""
  REMOTE_BTRFS_MOUNT_POINT=""
  REMOTE_SUBVOLUMES=()

  while IFS= read -r line; do
    case "$line" in
      HOST_LABEL=*)
        REMOTE_HOST_LABEL="${line#HOST_LABEL=}"
        ;;
      BTRFS_MOUNT_POINT=*)
        REMOTE_BTRFS_MOUNT_POINT="${line#BTRFS_MOUNT_POINT=}"
        ;;
      SUBVOLUMES=*)
        subvolumes_line="${line#SUBVOLUMES=}"
        ;;
    esac
  done <<< "$raw"

  [ -n "$subvolumes_line" ] && eval "REMOTE_SUBVOLUMES=${subvolumes_line}"

  [ -n "$REMOTE_HOST_LABEL" ] || _die "could not determine HOST_LABEL from ${host}"
  [ -n "$REMOTE_BTRFS_MOUNT_POINT" ] || _die "could not determine BTRFS_MOUNT_POINT from ${host}"
  [ "${#REMOTE_SUBVOLUMES[@]}" -gt 0 ] || _die "could not determine SUBVOLUMES from ${host}"
}

_consume_opt_value() {
  local -n _out="$1"; shift
  [ $# -ge 2 ] || _die "$1 requires an argument"
  _out="$2"
}

_parse_host_only_args() {
  local cmd_name="$1" varname="$2"; shift 2
  local -n _out="$varname"
  _out=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -H|--host)
        _consume_opt_value "$varname" "$@"
        shift 2
        ;;
      *)
        _die "${cmd_name}: unknown argument: $1"
        ;;
    esac
  done
}

# With a HOST, run SUBCMD there and exit with the remote status; otherwise
# return 0 so the caller continues locally.
_maybe_dispatch_remote() {
  local host="$1" subcmd="$2" status=0; shift 2
  [ -n "$host" ] || return 0
  _dispatch_remote "$host" "$subcmd" "$@" || status=$?
  exit "$status"
}

cmd_snapshot() {
  local tag host=""
  local -a snapshot_tags=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -t|--tag)
        _consume_opt_value tag "$@"
        snapshot_tags+=("$tag")
        shift 2
        ;;
      -H|--host)
        _consume_opt_value host "$@"
        shift 2
        ;;
      *)
        _die "snapshot: unknown argument: $1"
        ;;
    esac
  done

  _validate_tags "${snapshot_tags[@]}"
  local -a remote_args=()
  for tag in "${snapshot_tags[@]}"; do
    remote_args+=(--tag "$tag")
  done
  _maybe_dispatch_remote "$host" snapshot "${remote_args[@]}"
  _ensure_btrfs_mounted
  _run_snapshot_hook pre-snapshot || \
    _die "pre-snapshot hook failed; aborting snapshot"

  local snapshots_subvol="@snapshots"
  local now
  now=$(date +'%Y-%m-%d-%H%M%S')
  local snapshot_dir
  snapshot_dir="$(cd "$BTRFS_MOUNT_POINT" && pwd -P)/${snapshots_subvol}/${now}"

  mkdir -p "$snapshot_dir"

  _info "Creating snapshot set ${now} ..."
  local subvol snapshot_name
  (
    cd "$BTRFS_MOUNT_POINT"
    for subvol in "${SUBVOLUMES[@]}"; do
      snapshot_name="@snapshot-${now}-${HOST_LABEL}-${subvol}"
      if ! btrfs subvolume snapshot -r "$subvol" "${snapshots_subvol}/${now}/${snapshot_name}"; then
        _error "failed to snapshot subvolume '${subvol}'; partial snapshot set at ${snapshot_dir} requires clean up"
        exit 1
      fi
    done
  ) || exit 1

  _write_tags "$snapshot_dir" "${snapshot_tags[@]}"
  _info "Setting latest -> ${now}"
  _update_symlink "$now" "${BTRFS_MOUNT_POINT}/${snapshots_subvol}/latest" || true
  _run_snapshot_hook post-snapshot "$snapshot_dir" || \
    _die "post-snapshot hook failed"
  local tag_display
  tag_display=$(_display_tags "$snapshot_dir")
  _info "Created snapshot set: ${now}${tag_display:+ (tags: ${tag_display})}"
}

cmd_list() {
  local host

  _parse_host_only_args list host "$@"
  _maybe_dispatch_remote "$host" list
  _ensure_btrfs_mounted

  local snapshots_dir="${BTRFS_MOUNT_POINT}/@snapshots"
  if [ ! -d "$snapshots_dir" ]; then
    _info "No snapshots found."
    return
  fi

  local -a set_names=() tags=() flags_list=()
  local host_width=${#HOST_LABEL} set_width=3 tag_width=4
  [ "$host_width" -ge 4 ] || host_width=4

  local found=0 d set_name tag flags
  for d in "$snapshots_dir"/*/; do
    set_name=$(basename "$d")
    _is_set_name "$set_name" || continue
    tag=$(_display_tags "${d%/}")
    flags=$(_snapshot_flags "$snapshots_dir" "$set_name")
    set_names+=("$set_name")
    tags+=("$tag")
    flags_list+=("$flags")
    [ "${#set_name}" -le "$set_width" ] || set_width=${#set_name}
    [ "${#tag}" -le "$tag_width" ] || tag_width=${#tag}
    found=1
  done

  _table_row "$OUT_BOLD" '%-*s    %-*s    %-*s    %s' \
    "$host_width" "HOST" "$set_width" "SET" "$tag_width" "TAGS" "FLAGS"
  local i
  for i in "${!set_names[@]}"; do
    _table_row '' '%-*s    %-*s    %-*s    %s' \
      "$host_width" "$HOST_LABEL" "$set_width" "${set_names[i]}" \
      "$tag_width" "${tags[i]}" "${flags_list[i]}"
  done
  [ "$found" -eq 1 ] || _info "No snapshot sets found."
}

cmd_prune() {
  local host="" dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -H|--host)
        _consume_opt_value host "$@"
        [ -n "$host" ] || _die "prune: $1 must not be empty"
        shift 2
        ;;
      -n|--dry-run) dry_run=1; shift ;;
      *) _die "prune: unknown argument: $1" ;;
    esac
  done
  local -a remote_args=()
  [ "$dry_run" -eq 0 ] || remote_args+=(--dry-run)
  _maybe_dispatch_remote "$host" prune "${remote_args[@]}"
  _ensure_btrfs_mounted
  local snapshots_dir="${BTRFS_MOUNT_POINT}/@snapshots"
  [ -d "$snapshots_dir" ] || { _info "No snapshots found."; return 0; }
  _run_prune "$dry_run" 1 "$snapshots_dir"
}

cmd_latest() {
  local host

  _parse_host_only_args latest host "$@"
  _maybe_dispatch_remote "$host" latest
  _ensure_btrfs_mounted

  local snapshots_dir="${BTRFS_MOUNT_POINT}/@snapshots"
  local latest_link="${snapshots_dir}/latest"
  [ -L "$latest_link" ] || _die "no ${latest_link} symlink found"

  basename "$(readlink -f "$latest_link")"
}

cmd_rm() {
  local host="" set_name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -H|--host)
        _consume_opt_value host "$@"
        shift 2
        ;;
      -*)
        _die "rm: unknown option: $1"
        ;;
      *)
        [ -z "$set_name" ] || _die "rm: unexpected extra argument: $1"
        set_name="$1"
        shift
        ;;
    esac
  done
  [ -n "$set_name" ] || _die "rm: SET_NAME is required"
  _is_set_name "$set_name" || _die "rm: invalid SET_NAME: $set_name"

  _maybe_dispatch_remote "$host" rm "$set_name"
  _ensure_btrfs_mounted

  local snapshots_dir="${BTRFS_MOUNT_POINT}/@snapshots"
  local set_dir="${snapshots_dir}/${set_name}"
  [ -d "$set_dir" ] || _die "no such snapshot set: ${set_dir}"

  local flags
  flags=$(_snapshot_flags "$snapshots_dir" "$set_name")
  [ -z "$flags" ] || _warn "Snapshot set ${set_name} is current: ${flags}"

  _delete_set_dir "$set_dir" || return 1

  local latest_link="${snapshots_dir}/latest"
  if [ -L "$latest_link" ] && [ "$(readlink "$latest_link")" = "$set_name" ]; then
    local next
    next=$(_next_most_recent_set "$snapshots_dir")
    if [ -n "$next" ]; then
      _info "Setting latest -> ${next}"
      _update_symlink "$next" "$latest_link" || true
    else
      rm -f "$latest_link"
    fi
  fi

  _info "Removed snapshot set: ${set_name}"
}

cmd_tag() {
  local host="" set_name action
  local -a args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -H|--host)
        _consume_opt_value host "$@"
        shift 2
        ;;
      -*)
        _die "tag: unknown option: $1"
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done
  [ "${#args[@]}" -ge 3 ] || _die "tag: usage: tag SET_ID {add|rm} TAG... [-H|--host HOST]"
  set_name="${args[0]}"
  action="${args[1]}"
  _is_set_name "$set_name" || _die "tag: invalid SET_ID: ${set_name}"
  _validate_tag_operation tag "$action" "${args[@]:2}"

  _maybe_dispatch_remote "$host" tag "${args[@]}"
  _ensure_btrfs_mounted

  local snapshots_dir="${BTRFS_MOUNT_POINT}/@snapshots"
  local set_dir="${snapshots_dir}/${set_name}"
  [ -d "$set_dir" ] || _die "no such snapshot set: ${set_dir}"

  _modify_tags "$set_dir" "$action" "${args[@]:2}"
  _info "Tags for ${set_name}: $(_display_tags "$set_dir")"
}

_require_btrctl_marker() {
  local dir="$1"
  [ -f "${dir}/.btrctl" ] || \
    _die "${dir} exists but is not configured for btrctl (missing ${dir}/.btrctl)"
}

_ensure_trunk_host_subvol() {
  local dir="$1"
  if [ ! -e "$dir" ]; then
    _info "Creating trunk subvolume: ${dir}"
    btrfs subvolume create "$dir" > /dev/null
    : > "${dir}/.btrctl"
  elif ! btrfs subvolume show "$dir" > /dev/null 2>&1; then
    _die "${dir} exists but is not a btrfs subvolume"
  else
    _require_btrctl_marker "$dir"
  fi
}
_trunk_id() {
  local trunk_id_file="${TRUNK_MOUNT_POINT}/.btrctl/trunk-id"
  [ -f "$trunk_id_file" ] || _die "missing ${trunk_id_file}"
  local trunk_id
  trunk_id=$(cat "$trunk_id_file")
  [ -n "$trunk_id" ] || _die "${trunk_id_file} is empty"
  echo "$trunk_id"
}

cmd_trunk_id() {
  [ $# -eq 0 ] || _die "trunk id: usage: trunk id"
  _ensure_trunk_mounted
  _trunk_id
}

cmd_trunk_backup() {
  local host="" set_name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -H|--host)
        _consume_opt_value host "$@"
        shift 2
        ;;
      -*)
        _die "trunk backup: unknown option: $1"
        ;;
      *)
        [ -z "$set_name" ] || _die "trunk backup: unexpected extra argument: $1"
        _is_set_name "$1" || _die "trunk backup: invalid SET_NAME: $1"
        set_name="$1"
        shift
        ;;
    esac
  done
  _require_root
  _ensure_trunk_mounted

  local trunk_id
  trunk_id=$(_trunk_id)

  _trunk_backup "$trunk_id" "$host" "$set_name"
}

_src_run() {
  if [ -n "${SRC_HOST:-}" ]; then
    _remote_root "$SRC_HOST" "$SRC_PW" "$1"
  else
    sh -c "$1"
  fi
}

_src_send_receive() {
  if [ -n "${SRC_HOST:-}" ]; then
    printf '%s\n' "$SRC_PW" | _ssh "$SRC_HOST" "sudo -S -p '' $1 2>/dev/null" | btrfs receive "$2"
  else
    eval "$1" | btrfs receive "$2"
  fi
}

_copy_set_metadata() {
  local src_set_dir="$1" target_set_dir="$2"
  local src_metadata_dir="${src_set_dir}/.btrctl" target_metadata_dir="${target_set_dir}/.btrctl"
  local invalid_path metadata_state

  metadata_state=$(_src_run "if test -e '${src_metadata_dir}' || test -L '${src_metadata_dir}'; then printf present; else printf absent; fi") || {
    _error "failed to inspect snapshot metadata: ${src_metadata_dir}"
    return 1
  }
  [ "$metadata_state" = absent ] && return 0
  if [ "$metadata_state" != present ]; then
    _error "could not determine snapshot metadata state: ${src_metadata_dir}"
    return 1
  fi
  if ! _src_run "test -d '${src_metadata_dir}' && test ! -L '${src_metadata_dir}'"; then
    _error "snapshot metadata is not a directory: ${src_metadata_dir}"
    return 1
  fi

  invalid_path=$(_src_run "find '${src_metadata_dir}' -xdev \\( -type l -o \\( ! -type d -a ! -type f \\) \\) -print -quit") || {
    _error "failed to inspect snapshot metadata: ${src_metadata_dir}"
    return 1
  }
  if [ -n "$invalid_path" ]; then
    _error "snapshot metadata contains an unsupported file type: ${invalid_path}"
    return 1
  fi

  if ! _src_run "tar --one-file-system --hard-dereference -C '${src_set_dir}' -cf - .btrctl" \
    | tar --no-same-owner --no-same-permissions --touch -C "$target_set_dir" -xf -; then
    _error "failed to copy snapshot metadata from ${src_metadata_dir}"
    return 1
  fi

  find "$target_metadata_dir" -type d -exec chmod 755 {} +
  find "$target_metadata_dir" -type f -exec chmod 644 {} +
}

_trunk_backup() {
  local trunk_id="$1" host="${2:-}" set_name="${3:-}"
  local label snapshots_dir subvols

  SRC_HOST=""
  SRC_PW=""
  if [ -n "$host" ]; then
    SRC_HOST="$host"
    _remote_config "$host"
    label="$REMOTE_HOST_LABEL"
    snapshots_dir="${REMOTE_BTRFS_MOUNT_POINT}/@snapshots"
    subvols=("${REMOTE_SUBVOLUMES[@]}")

    read -rs -p "$(_remote_sudo_prompt "$host")" SRC_PW
    echo >&2

    _src_run "mountpoint -q '${REMOTE_BTRFS_MOUNT_POINT}'" || \
      _die "${REMOTE_BTRFS_MOUNT_POINT} is not mounted on ${host}"
  else
    _ensure_btrfs_mounted
    label="$HOST_LABEL"
    snapshots_dir="${BTRFS_MOUNT_POINT}/@snapshots"
    subvols=("${SUBVOLUMES[@]}")
  fi

  local parent_link="${snapshots_dir}/trunk_${trunk_id}"
  local err_parent_dangling
  if [ -n "$host" ]; then
    err_parent_dangling="trunk_${trunk_id} tracking symlink on ${host} is dangling"
  else
    err_parent_dangling="${parent_link} is dangling"
  fi

  local set_timestamp
  if [ -n "$set_name" ]; then
    set_timestamp="$set_name"
    if ! _src_run "test -d '${snapshots_dir}/${set_timestamp}'"; then
      if [ -n "$host" ]; then
        _die "snapshot set not found on ${host}: ${set_timestamp}"
      else
        _die "no such snapshot set: ${snapshots_dir}/${set_timestamp}"
      fi
    fi
  else
    local latest_link="${snapshots_dir}/latest" resolved_latest err_no_latest err_latest_dangling
    if [ -n "$host" ]; then
      err_no_latest="no latest snapshot set found on ${host}"
      err_latest_dangling="latest snapshot symlink on ${host} is dangling"
    else
      err_no_latest="no ${latest_link} symlink found"
      err_latest_dangling="${latest_link} is dangling"
    fi
    resolved_latest=$(_src_run "readlink -f '${latest_link}'" 2>/dev/null || true)
    [ -n "$resolved_latest" ] || _die "$err_no_latest"
    _src_run "test -d '${resolved_latest}'" || _die "$err_latest_dangling"
    set_timestamp=$(basename "$resolved_latest")
  fi

  local parent_timestamp=""
  if _src_run "test -e '${parent_link}' || test -L '${parent_link}'"; then
    local resolved_parent
    resolved_parent=$(_src_run "readlink -f '${parent_link}'" 2>/dev/null || true)
    if [ -n "$resolved_parent" ] && _src_run "test -d '${resolved_parent}'"; then
      parent_timestamp=$(basename "$resolved_parent")
    else
      _die "$err_parent_dangling"
    fi
  fi

  local target_host_dir="${TRUNK_MOUNT_POINT}/@${label}"
  _ensure_trunk_host_subvol "$target_host_dir"

  local target_set_dir="${target_host_dir}/${set_timestamp}"
  if [ -e "$target_set_dir" ] || [ -L "$target_set_dir" ]; then
    _die "trunk snapshot set already exists: ${target_set_dir}"
  fi
  mkdir "$target_set_dir"

  local subvol current_path parent_path send_cmd kind
  for subvol in "${subvols[@]}"; do
    current_path=$(_snapshot_subvol_path "${snapshots_dir}/${set_timestamp}" "$set_timestamp" "$label" "$subvol")
    if ! _src_run "test -e '${current_path}'"; then
      if [ -n "$host" ]; then
        _error "expected remote snapshot not found: ${host}:${current_path}"
        return 1
      fi
      _die "expected snapshot not found: ${current_path}"
    fi

    parent_path=""
    # A newer tracking target cannot be an incremental parent for an older selected set.
    if [ -n "$parent_timestamp" ] && [[ "$parent_timestamp" < "$set_timestamp" ]]; then
      local candidate trunk_parent
      candidate=$(_snapshot_subvol_path "${snapshots_dir}/${parent_timestamp}" "$parent_timestamp" "$label" "$subvol")
      # btrfs receive needs the parent to exist on trunk too; it may have been pruned or removed.
      trunk_parent=$(_snapshot_subvol_path "${target_host_dir}/${parent_timestamp}" "$parent_timestamp" "$label" "$subvol")
      if [ ! -d "$trunk_parent" ]; then
        _info "Parent snapshot set ${parent_timestamp} not found on trunk for ${host:+${host}:}${subvol}; sending full snapshot"
      elif _src_run "test -e '${candidate}'"; then
        parent_path="$candidate"
      fi
    fi

    _info "Backing up ${host:+${host}:}${subvol} (${set_timestamp}) to ${target_set_dir} ..."
    if [ -n "$parent_path" ]; then
      _info "Using parent snapshot set ${parent_timestamp} for ${host:+${host}:}${subvol}"
      send_cmd="btrfs send -p '${parent_path}' '${current_path}'"
      kind="incremental"
    else
      send_cmd="btrfs send '${current_path}'"
      kind="full"
    fi

    if ! _src_send_receive "$send_cmd" "$target_set_dir"; then
      if [ -n "$host" ]; then
        _error "send/receive failed for ${host}:${subvol} -- any partially-received data under ${target_set_dir} requires clean up"
      else
        _error "${kind} send/receive failed for ${subvol} -- any partially-received data under ${target_set_dir} requires clean up"
      fi
      return 1
    fi
  done

  local src_set_dir="${snapshots_dir}/${set_timestamp}"
  _copy_set_metadata "$src_set_dir" "$target_set_dir" || return 1

  if [ -n "$host" ]; then
    _info "setting trunk_${trunk_id} -> ${set_timestamp} on ${host}"
    local symlink_cmd="if [ -e '${parent_link}' ] && [ ! -L '${parent_link}' ]; then exit 1; fi; ln -sfn '${set_timestamp}' '${parent_link}'"
    if ! _src_run "$symlink_cmd"; then
      _warn "backup succeeded, but could not update remote trunk_${trunk_id} symlink on ${host}"
    fi
  else
    _info "Setting trunk_${trunk_id} -> ${set_timestamp}"
    _update_symlink "$set_timestamp" "$parent_link" || true
  fi

  _info "Backed up ${label}/${set_timestamp}${host:+ (remote: ${host})} to trunk (id: ${trunk_id})"
}

_trunk_host_labels() {
  local host_dir label
  for host_dir in "${TRUNK_MOUNT_POINT}"/@*/; do
    host_dir="${host_dir%/}"
    [ -f "${host_dir}/.btrctl" ] || continue
    label="${host_dir##*/}"
    printf '%s\n' "${label#@}"
  done
}

cmd_trunk_hosts() {
  [ $# -eq 0 ] || _die "trunk hosts: usage: trunk hosts"
  _ensure_trunk_mounted
  _trunk_host_labels
}

cmd_trunk_list() {
  [ $# -le 1 ] || _die "trunk list: usage: trunk list [HOST]"

  local requested_label="${1:-}"
  case "$requested_label" in
    -*) _die "trunk list: HOST is a positional argument, not a flag" ;;
  esac

  _ensure_trunk_mounted

  local -a host_dirs=() set_hosts=() set_names=() tags=()
  local host_dir label trunk_host d set_name tag
  if [ -n "$requested_label" ]; then
    host_dir="${TRUNK_MOUNT_POINT}/@${requested_label}"
    if [ ! -d "$host_dir" ]; then
      _info "No trunk backups found for host '${requested_label}'."
      return
    fi
    host_dirs+=("$host_dir")
  else
    while IFS= read -r label; do
      host_dirs+=("${TRUNK_MOUNT_POINT}/@${label}")
    done < <(_trunk_host_labels)
    [ "${#host_dirs[@]}" -gt 0 ] || {
      _info "No trunk backups found."
      return
    }
  fi

  local host_width=4 set_width=3
  for host_dir in "${host_dirs[@]}"; do
    _require_btrctl_marker "$host_dir"
    label="${host_dir##*/}"
    label="${label#@}"
    trunk_host="trunk/${label}"
    [ "${#trunk_host}" -le "$host_width" ] || host_width=${#trunk_host}

    for d in "$host_dir"/*/; do
      set_name=$(basename "$d")
      _is_set_name "$set_name" || continue
      tag=$(_display_tags "${d%/}")
      set_hosts+=("$trunk_host")
      set_names+=("$set_name")
      tags+=("$tag")
      [ "${#set_name}" -le "$set_width" ] || set_width=${#set_name}
    done
  done

  _table_row "$OUT_BOLD" '%-*s    %-*s    %s' \
    "$host_width" "HOST" "$set_width" "SET" "TAGS"

  local i previous_host=""
  for i in "${!set_names[@]}"; do
    if [ -n "$previous_host" ] && [ "${set_hosts[i]}" != "$previous_host" ]; then
      printf '\n'
    fi
    _table_row '' '%-*s    %-*s    %s' \
      "$host_width" "${set_hosts[i]}" "$set_width" "${set_names[i]}" "${tags[i]}"
    previous_host="${set_hosts[i]}"
  done
  if [ "${#set_names[@]}" -eq 0 ]; then
    if [ -n "$requested_label" ]; then
      _info "No snapshot sets found for host '${requested_label}'."
    else
      _info "No snapshot sets found."
    fi
  fi
}

cmd_trunk_prune() {
  local requested_label="" all=0 dry_run=0 label host_dir
  local -a host_dirs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--all) all=1; shift ;;
      -n|--dry-run) dry_run=1; shift ;;
      -*) _die "trunk prune: unknown option: $1" ;;
      *)
        [ -z "$requested_label" ] || _die "trunk prune: unexpected extra argument: $1"
        requested_label="$1"
        [ -n "$requested_label" ] || _die "trunk prune: HOST must not be empty"
        case "$requested_label" in
          */*) _die "trunk prune: invalid HOST: ${requested_label}" ;;
        esac
        shift
        ;;
    esac
  done
  if [ "$all" -eq 1 ]; then
    [ -z "$requested_label" ] || _die "trunk prune: HOST and -a|--all are mutually exclusive"
  else
    [ -n "$requested_label" ] || _die "trunk prune: usage: trunk prune {HOST|-a|--all} [-n|--dry-run]"
  fi
  _ensure_trunk_mounted
  if [ "$all" -eq 1 ]; then
    while IFS= read -r label; do
      host_dirs+=("${TRUNK_MOUNT_POINT}/@${label}")
    done < <(_trunk_host_labels)
  else
    host_dir="${TRUNK_MOUNT_POINT}/@${requested_label}"
    [ -d "$host_dir" ] || _die "no such trunk host: ${host_dir}"
    host_dirs+=("$host_dir")
  fi
  for host_dir in "${host_dirs[@]}"; do
    _require_btrctl_marker "$host_dir"
  done
  [ "${#host_dirs[@]}" -gt 0 ] || { _info "No trunk backups found."; return 0; }
  _run_prune "$dry_run" 0 "${host_dirs[@]}"
}

cmd_trunk_rm() {
  [ $# -eq 1 ] || _die "trunk rm: usage: trunk rm HOST/SET_NAME"
  local arg="$1"
  case "$arg" in
    */*) : ;;
    *) _die "trunk rm: expected HOST/SET_NAME (e.g. remotehost/2025-01-15-120000)" ;;
  esac
  local host_label="${arg%%/*}"
  local set_name="${arg#*/}"
  [ -n "$host_label" ] && [ -n "$set_name" ] || _die "trunk rm: expected HOST/SET_NAME"
  _is_set_name "$set_name" || _die "trunk rm: invalid SET_NAME: $set_name"

  _ensure_trunk_mounted

  local host_dir="${TRUNK_MOUNT_POINT}/@${host_label}"
  [ -d "$host_dir" ] || _die "no such trunk host: ${host_dir}"
  _require_btrctl_marker "$host_dir"

  local set_dir="${host_dir}/${set_name}"
  [ -d "$set_dir" ] || _die "no such trunk snapshot set: ${set_dir}"

  _delete_set_dir "$set_dir" || return 1
  _info "Removed trunk snapshot set: ${host_label}/${set_name}"
}

cmd_trunk_tag() {
  [ $# -ge 3 ] || _die "trunk tag: usage: trunk tag HOST/SET_ID {add|rm} TAG..."
  local arg="$1" action="$2" host_label set_name
  shift 2
  host_label="${arg%%/*}"
  set_name="${arg#*/}"
  [[ "$arg" = */* ]] && [ -n "$host_label" ] || _die "trunk tag: expected HOST/SET_ID"
  _is_set_name "$set_name" || _die "trunk tag: invalid SET_ID: ${set_name}"
  _validate_tag_operation "trunk tag" "$action" "$@"
  _ensure_trunk_mounted

  local host_dir="${TRUNK_MOUNT_POINT}/@${host_label}"
  [ -d "$host_dir" ] || _die "no such trunk host: ${host_dir}"
  _require_btrctl_marker "$host_dir"
  local set_dir="${host_dir}/${set_name}"
  [ -d "$set_dir" ] || _die "no such trunk snapshot set: ${set_dir}"

  _modify_tags "$set_dir" "$action" "$@"
  _info "Tags for ${arg}: $(_display_tags "$set_dir")"
}

cmd_config() {
  echo "CONF_FILE=${CONF_FILE}"
  echo "CONF_OVERLAY_FILE=${CONF_OVERLAY_FILE}"
  echo "HOST_LABEL=${HOST_LABEL}"
  echo "BTRFS_MOUNT_POINT=${BTRFS_MOUNT_POINT}"
  echo "SUBVOLUMES=(${SUBVOLUMES[*]})"
  echo "TRUNK_MOUNT_POINT=${TRUNK_MOUNT_POINT}"
}

cmd_help() {
  local c_reset='' c_bold='' c_var=''
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    c_reset=$'\033[0m'
    c_bold=$'\033[1m'
    c_var=$'\033[33m'
  fi

  cat <<EOF

${c_bold}btrctl${c_reset} - Btrfs snapshot and trunk backup tool

${c_bold}USAGE:${c_reset}
  ${c_bold}btrctl${c_reset} <command> [options]

${c_bold}COMMANDS:${c_reset}
  ${c_bold}snapshot${c_reset} [-t|--tag ${c_var}TAG${c_reset} ...] [-H|--host ${c_var}HOST${c_reset}]
  ${c_bold}list${c_reset} [-H|--host ${c_var}HOST${c_reset}]
  ${c_bold}prune${c_reset} [-H|--host ${c_var}HOST${c_reset}] [-n|--dry-run]
  ${c_bold}latest${c_reset} [-H|--host ${c_var}HOST${c_reset}]
  ${c_bold}rm${c_reset} ${c_var}SET_NAME${c_reset} [-H|--host ${c_var}HOST${c_reset}]
  ${c_bold}tag${c_reset} ${c_var}SET_ID${c_reset} {add|rm} ${c_var}TAG${c_reset}... [-H|--host ${c_var}HOST${c_reset}]

  ${c_bold}trunk id${c_reset}
  ${c_bold}trunk backup${c_reset} [${c_var}SET_NAME${c_reset}] [-H|--host ${c_var}HOST${c_reset}]
  ${c_bold}trunk hosts${c_reset}
  ${c_bold}trunk list${c_reset} [${c_var}HOST${c_reset}]
  ${c_bold}trunk prune${c_reset} {${c_var}HOST${c_reset}|-a|--all} [-n|--dry-run]
  ${c_bold}trunk rm${c_reset} ${c_var}HOST${c_reset}/${c_var}SET_NAME${c_reset}
  ${c_bold}trunk tag${c_reset} ${c_var}HOST${c_reset}/${c_var}SET_ID${c_reset} {add|rm} ${c_var}TAG${c_reset}...

  ${c_bold}config${c_reset}
  ${c_bold}help${c_reset}, ${c_bold}-h${c_reset}, ${c_bold}--help${c_reset}

EOF
}

main() {
  if [ "${1:-}" = "--remote-label" ]; then
    _consume_opt_value REMOTE_LABEL "$@"
    shift 2
  fi

  local cmd="${1:-}"
  case "$cmd" in
    "")                    cmd_help; exit 1  ;;
    help|-h|--help)        cmd_help          ;;
    snapshot)       shift; cmd_snapshot "$@" ;;
    list)           shift; cmd_list "$@"     ;;
    prune)          shift; cmd_prune "$@"    ;;
    latest)         shift; cmd_latest "$@"   ;;
    rm)             shift; cmd_rm "$@"       ;;
    tag)            shift; cmd_tag "$@"      ;;
    config)         shift; cmd_config "$@"   ;;
    trunk)
      shift
      local sub="${1:-}"
      case "$sub" in
        id)             shift; cmd_trunk_id "$@"     ;;
        backup)         shift; cmd_trunk_backup "$@" ;;
        hosts)          shift; cmd_trunk_hosts "$@"  ;;
        list)           shift; cmd_trunk_list "$@"   ;;
        prune)          shift; cmd_trunk_prune "$@"  ;;
        rm)             shift; cmd_trunk_rm "$@"     ;;
        tag)            shift; cmd_trunk_tag "$@"    ;;
        *) _die "unknown trunk subcommand: ${sub:-<none>}" ;;
      esac ;;
    *) _die "unknown command: ${cmd}" ;;
  esac
}

[ "${BASH_SOURCE[0]}" = "${0}" ] && main "$@"
